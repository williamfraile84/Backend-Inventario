# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SERVIDOR (FASTAPI & UVICORN)
# ==============================================================================
APP_NAME="Fruver POS Manager"
APP_ENV=development
API_V1_PREFIX=/api
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ==============================================================================
# BASE DE DATOS AGNÓSTICA (POSTGRESQL / SUPABASE / SQLITE WAL / MYSQL)
# ==============================================================================
# Motor activo: "sqlite", "postgresql", "supabase", "mysql", "oracle"
DB_ENGINE=sqlite
DB_NAME=fruver_pos.db

# Parámetros desglosados (facilitan contraseñas con caracteres especiales o pooling Supabase)
# DB_ENGINE=postgresql
# DB_USER=postgres.tu_proyecto_id
# DB_PASSWORD=TuPasswordSeguro123!
# DB_HOST=aws-0-ca-central-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_SSLMODE=require
# DB_USE_NULLPOOL=true

# O URL completa SQLAlchemy directa:
# DATABASE_URL=postgresql+psycopg2://postgres:pass@localhost:5432/fruver_db

# ==============================================================================
# CONTROL DE MIGRACIÓN ENTRE BASES DE DATOS (BIDIRECCIONAL Y AGNÓSTICO)
# ==============================================================================
AUTO_MIGRATE_DB=false
MIGRATE_SOURCE_URL=sqlite:///./fruver_pos.db
MIGRATE_TARGET_URL=
MIGRATE_RESET_DESTINATION=false

# ==============================================================================
# SEGURIDAD, AUTENTICACIÓN JWT Y SESIONES
# ==============================================================================
SECRET_KEY=generar_clave_segura_aleatoria_para_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_INACTIVITY_TIMEOUT_MINUTES=480
ENFORCE_DB_SESSION_VALIDATION=false
CORS_ORIGINS=["*"]

# ==============================================================================
# USUARIO ADMINISTRADOR INICIAL DE LA APP WEB
# ==============================================================================
APP_ADMIN_USER=admin
APP_ADMIN_PASS=cambiar_password_admin

# ==============================================================================
# INTEGRACIÓN CON SISTEMA POS EXTERNO (CSOPOS / SOFTWAREPOS)
# ==============================================================================
POS_PRIMARY_URL=https://csopos.co/
POS_SECONDARY_URL=https://softwarepos.online/
POS_USER=tu_usuario_pos
POS_PASS=tu_password_pos
POS_STORE=tu_tienda
POS_REGISTER_NUM=1
POS_HEADLESS=true

# ==============================================================================
# REGLAS DE NEGOCIO FRUVER (PRECIOS, MARGEN % Y REDONDEO A CENTENAS $100)
# ==============================================================================
# Margen de utilidad por defecto (%)
DEFAULT_PROFIT_MARGIN=30.0
# Base de redondeo estándar en pesos colombianos (100 = centenas más cercana)
ROUNDING_BASE=100

# ==============================================================================
# PROVEEDOR DE ALMACENAMIENTO DE ARCHIVOS (STORAGE MULTI-PROVEEDOR)
# Opciones disponibles: "local", "s3", "supabase"
# ==============================================================================
STORAGE_PROVIDER=local
STORAGE_BASE_DIR=./storage
MAX_UPLOAD_SIZE_MB=15

# Parámetros para S3 / Supabase Storage / Cloudflare R2 / AWS S3
# S3_ENDPOINT_URL=https://tu_proyecto.storage.supabase.co/storage/v1/s3
# S3_REGION_NAME=ca-central-1
# S3_ACCESS_KEY_ID=tu_access_key
# S3_SECRET_ACCESS_KEY=tu_secret_key
# S3_BUCKET_NAME=fruver-pos-storage
# S3_USE_SSL=true

# ==============================================================================
# MOTORES DE RECONOCIMIENTO OCR & VISIÓN POR COMPUTADORA
# ==============================================================================
VISION_PROVIDER=gemini
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3-flash-preview
OCR_MAX_IMAGE_DIMENSION=1600
OCR_USE_SERVER_MODEL=false
OCR_USE_RAPID_TABLE=false
OCR_INTRA_OP_THREADS=4
OCR_INTER_OP_THREADS=1
OCR_REC_BATCH_NUM=16
OCR_ENABLE_PERSPECTIVE_WARP=true
CONFIDENCE_FALLBACK_THRESHOLD=0.70
# ==============================================================================
# INTEGRACIÓN FACTURACIÓN ELECTRÓNICA DIAN (CATÁLOGO VPFE & CÓDIGO QR)
# ==============================================================================
DIAN_RECEPTOR_NIT=""
DIAN_AUTO_QR_DETECTION=true
DIAN_AUTO_PORTAL_FETCH=true
DIAN_PORTAL_TIMEOUT_SECONDS=50
DIAN_HEADLESS_BROWSER=false
DIAN_BROWSER_CHANNEL=chrome

